; ---------------------------------------------------------
; Common Timing Parameters
; ---------------------------------------------------------
.define public T_HFRONT 31     ; FrontPorch
.define public T_HSYNC 31      ; PulseWidth
.define public T_HBACK 31      ; BackPorch

.define public T_VFRONT 31     ; FrontPorch
.define public T_VSYNC 31      ; PulseWidth
.define public T_VBACK 31      ; BackPorch

; ---------------------------------------------------------
; Horizontal Sync
; Runs on PIO0, state machine 0
; Triggers IRQ 2 at the end of the front porch
; ---------------------------------------------------------
.program hsync
.side_set 2                    ; LCD_PCLK_PIN(bit1) LCD_HSYNC_PIN(bit0)

pull block side 0b11           ; Pull the width to osr
mov y, osr side 0b11           ; Save the width to y

.wrap_target

; Front porch
set x, T_HFRONT side 0b11
FrontPorch:
nop side 0b11
jmp x-- FrontPorch side 0b11
; SyncPulse
irq set 2 side 0b01
set x, T_HSYNC side 0b10       ; Set HSYNC low
SyncPulse:
	nop side 0b00
	jmp x-- SyncPulse side 0b10
; Back porch
set x, T_HBACK side 0b01
BackPorch:
	nop side 0b11
	jmp x-- BackPorch side 0b01
mov x, y side 0b11             ; Restore width to x
ActiveFor:
	nop side 0b01
	jmp x--, ActiveFor side 0b11

.wrap

; ---------------------------------------------------------
; Vertical Sync
; Runs on PIO0, state machine 1
; ---------------------------------------------------------
.program vsync
.side_set 1                    ; LCD_VSYNC_PIN(bit0)

pull block side 1              ; Pull the height to osr

.wrap_target

; Signal the start of the VBLANK period to the main program
irq set 3 side 1

; Front porch
set x, T_VFRONT side 1
FrontPorch:
	wait 1 irq 2 side 1        ; Wait for hsync to signal the end of the line
	jmp x-- FrontPorch side 1

; SyncPulse
set x, T_VSYNC side 0          ; Set VSYNC low
SyncPulse:
	wait 1 irq 2 side 0        ; Wait for hsync to signal the end of the line
	jmp x-- SyncPulse side 0

; Back porch
set x, T_VBACK side 1          ; Set VSYNC high
BackPorch:
	wait 1 irq 2 side 1        ; Wait for hsync to signal the end of the line
	jmp x-- BackPorch side 1

mov x, osr side 1              ; Restore height to x

ActiveFor:
	wait 1 irq 2 side 1        ; Wait for hsync to signal the end of the line
	jmp x--, ActiveFor side 1

.wrap

; ---------------------------------------------------------
; RGB DE
; Runs on PIO1, state machine 0
; ---------------------------------------------------------
.program rgb_de
.side_set 1                    ; LCD_DE_PIN(bit0)

pull block side 0              ; Load the width to osr

.wrap_target

mov y, osr side 0              ; Save height to y
set x, T_VBACK side 0

wait 0 pin 5 side 0                    ; Wait for vsync to go low
wait 1 pin 5 side 0                    ; Wait for vsync to go high

vBackPorch:
	wait 0 pin 6 side 0                ; Wait for hsync to go low
	wait 1 pin 6 side 0                ; Wait for hsync to go high
	jmp x--, vBackPorch side 0

ActiveFor:
	wait 0 pin 6 side 0                ; Wait for hsync to go low
	wait 1 pin 6 side 0                ; Wait for hsync to go high

	set x, T_HBACK side 0
	hBackPorch:
		wait 0 pin 7 side 0            ; Wait for pclk to go low
		wait 1 pin 7 side 0            ; Wait for pclk to go high
		jmp x--, hBackPorch side 0
	
	wait 1 pin 7 side 0                ; Wait for pclk to go high

	irq set 1 side 0				   ; Tell RGB program to start the line

	wait 1 irq 0 side 1                ; Wait for RGB program to finish the line
	jmp y--, ActiveFor side 0

.wrap

; ---------------------------------------------------------
; RGB Data
; Runs on PIO1, state machine 1
; ---------------------------------------------------------
.program rgb

pull block                     ; Pull width into osr
mov y, osr                     ; Save width to y
.wrap_target

mov x,y                        ; Save width to x
; wait 1 pin 4                   ; Wait until DE program starts active line
wait 1 irq 1                   ; Wait until DE program starts active line
ColorOut:
	pull                  ; One RGB565 pixel in low 16 bits
	wait 0 pin 7               ; pclk == 0
	out pins, 16               ; Send rgb data
	wait 1 pin 7               ; pclk == 1
	jmp x--, ColorOut

irq set 0                      ; Tell program rgb_de that a row of data has been flushed
.wrap
